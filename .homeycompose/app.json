{
  "id": "gpm.linked.switches",
  "version": "1.1.1",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Linked Switches"
  },
  "brandColor": "#E63946",
  "description": {
    "en": "Link and synchronize ON/OFF switches in groups",
    "nl": "Koppel en synchroniseer aan/uit-schakelaars in groepen",
    "de": "Verknüpfe und synchronisiere Ein/Aus-Schalter in Gruppen",
    "fr": "Liez et synchronisez des interrupteurs ON/OFF en groupes",
    "es": "Vincula y sincroniza interruptores ON/OFF en grupos",
    "it": "Collega e sincronizza interruttori ON/OFF in gruppi"
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "settings": [
    {
      "id": "show_device_status",
      "type": "dropdown",
      "title": {
        "en": "Show subdevice status on Linked Switch cards"
      },
      "value": "true",
      "values": [
        {
          "id": "true",
          "title": {
            "en": "Show"
          }
        },
        {
          "id": "false",
          "title": {
            "en": "Hide"
          }
        }
      ]
    },
    {
      "id": "show_master_status",
      "type": "dropdown",
      "title": {
        "en": "Show subdevice status on Switch Master cards"
      },
      "value": "false",
      "values": [
        {
          "id": "true",
          "title": {
            "en": "Show"
          }
        },
        {
          "id": "false",
          "title": {
            "en": "Hide"
          }
        }
      ]
    }
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Gabriel Pedrosa Machado",
    "email": "g.machado@me.com"
  },
  "source": "https://github.com/gpmachado/gpm.linked.switches"
}