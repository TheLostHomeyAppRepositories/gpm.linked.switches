  "flow": {
    "triggers": [
      {
        "title": {
          "en": "A device failed to sync",
          "nl": "Een apparaat kon niet synchroniseren",
          "de": "Ein Gerät konnte nicht synchronisiert werden",
          "fr": "Un appareil n'a pas pu se synchroniser",
          "es": "Un dispositivo no pudo sincronizarse",
          "it": "Un dispositivo non è riuscito a sincronizzarsi"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=switch-sync"
          }
        ],
        "tokens": [
          {
            "name": "device_name",
            "type": "string",
            "title": {
              "en": "Device",
              "nl": "Apparaat",
              "de": "Gerät",
              "fr": "Appareil",
              "es": "Dispositivo",
              "it": "Dispositivo"
            },
            "example": "Kitchen Light"
          },
          {
            "name": "expected_state",
            "type": "string",
            "title": {
              "en": "Expected",
              "nl": "Verwacht",
              "de": "Erwartet",
              "fr": "Attendu",
              "es": "Esperado",
              "it": "Atteso"
            },
            "example": "ON"
          },
          {
            "name": "actual_state",
            "type": "string",
            "title": {
              "en": "Actual",
              "nl": "Werkelijk",
              "de": "Tatsächlich",
              "fr": "Réel",
              "es": "Real",
              "it": "Reale"
            },
            "example": "OFF"
          }
        ],
        "id": "group_desynced"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Group !{{is|is not}} fully synced",
          "nl": "Groep !{{is|is niet}} volledig gesynchroniseerd",
          "de": "Gruppe !{{ist|ist nicht}} vollständig synchronisiert",
          "fr": "Le groupe !{{est|n'est pas}} entièrement synchronisé",
          "es": "El grupo !{{está|no está}} totalmente sincronizado",
          "it": "Il gruppo !{{è|non è}} completamente sincronizzato"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=switch-sync"
          }
        ],
        "id": "group_is_synced"
      },
      {
        "title": {
          "en": "Group !{{is|is not}} waiting for an offline device",
          "nl": "Groep !{{wacht|wacht niet}} op een offline apparaat",
          "de": "Gruppe !{{wartet|wartet nicht}} auf ein Offline-Gerät",
          "fr": "Le groupe !{{attend|n'attend pas}} un appareil hors ligne",
          "es": "El grupo !{{está esperando|no está esperando}} un dispositivo sin conexión",
          "it": "Il gruppo !{{è in attesa di|non è in attesa di}} un dispositivo offline"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=switch-sync"
          }
        ],
        "id": "group_pending_offline"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Force resync",
          "nl": "Forceer hersynchronisatie",
          "de": "Neusynchronisierung erzwingen",
